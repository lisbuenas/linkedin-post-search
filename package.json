{
	"name": "linkedin-posts-search-scraper",
	"version": "0.0.1",
	"type": "module",
	"description": "Apify actor that searches LinkedIn posts by keyword and extracts content, author details, reactions and media — no cookies or account required.",
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"apify": "^3.2.6",
		"axios": "^1.7.9",
		"crawlee": "^3.11.5",
		"puppeteer": "25.1.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2"
	},
	"devDependencies": {
		"@apify/eslint-config-ts": "^0.3.0",
		"@apify/tsconfig": "^0.1.0",
		"@types/jest": "^29.5.14",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.50.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"tsx": "^4.6.2",
		"typescript": "^5.7.3"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "tsx src/main.ts",
		"build": "tsc",
		"lint": "eslint ./src --ext .ts",
		"lint:fix": "eslint ./src --ext .ts --fix",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
